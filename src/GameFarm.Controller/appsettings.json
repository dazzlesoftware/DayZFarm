{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GameFarm": {
    // This still points at the real, existing data directory on this host (VMs, the client
    // database, uploaded plugins/agent packages) -- renaming the C#/project identity to
    // "GameFarm" does not rename anything that already exists on disk. Only move this to
    // D:\GameFarm if you actually move/rename the real folder to match.
    "RootDirectory": "D:\\DayZFarm",

    // Which hypervisor backend to use for the whole farm: "HyperV" or "VMwareWorkstation"
    // (currently active). The two are mutually exclusive in practice on one host -- see
    // docs/VMWARE-SETUP.md before switching this. Requires a Controller restart to take effect.
    "Hypervisor": "VMwareWorkstation",

    // --- Hyper-V-specific (ignored while Hypervisor is VMwareWorkstation) ---
    "MasterVhdx": "D:\\DayZFarm\\Images\\DayZ-Master.vhdx",
    "VirtualSwitch": "DayZFarmSwitch",

    // --- VMware Workstation-specific (active) -- see docs/VMWARE-SETUP.md ---
    "MasterVmx": "D:\\Virtual Machines\\Windows 11 x64\\Windows 11 x64.vmx",
    "MasterVmxSnapshot": "Baseline",
    "VMwareNetworkName": "vmnet8",
    "VmrunPath": "C:\\Program Files\\VMware\\VMware Workstation\\vmrun.exe",

    "DefaultCpuCount": 4,
    "DefaultMemoryGB": 6,
    "StatusPollSeconds": 10,
    "MaxConcurrentVmOperations": 10,
    "MaxConcurrentAgentCommands": 20,
    "UpdateBatchSize": 5,
    "AgentPort": 5099,
    "ReconnectBackoffSeconds": [ 5, 10, 30, 60 ],
    "MaxReconnectBackoffSeconds": 300
  }
}
