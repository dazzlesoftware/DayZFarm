{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DayZFarm": {
    "RootDirectory": "D:\\DayZFarm",
    "MasterVhdx": "D:\\DayZFarm\\Images\\DayZ-Master.vhdx",
    "VirtualSwitch": "DayZFarmSwitch",
    "DefaultCpuCount": 4,
    "DefaultMemoryGB": 6,
    "StatusPollSeconds": 10,
    "MaxConcurrentVmOperations": 10,
    "MaxConcurrentAgentCommands": 20,
    "UpdateBatchSize": 5,
    "AgentPort": 5099,
    "ReconnectBackoffSeconds": [ 5, 10, 30, 60 ],
    "MaxReconnectBackoffSeconds": 300
  }
}
